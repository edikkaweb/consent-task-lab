{
  "name": "consent-task-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Reproducible consent-to-product-filter experiment",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "start": "node scripts/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/functional.mjs",
    "pilot": "node scripts/measure.mjs --phase=pilot --repetitions=2",
    "freeze": "node scripts/freeze.mjs",
    "measure": "node scripts/measure.mjs --phase=main --repetitions=20",
    "analyze": "node scripts/analyze.mjs results/main",
    "verify": "node scripts/verify.mjs results/main"
  },
  "devDependencies": {"playwright": "1.63.0"}
}
